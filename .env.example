# Copy this file to .env for local development. Never commit the real .env.
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./cinematch.db
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Deployment ---
# Allow the deployed Frontend to call this API. JSON list, no trailing slash.
# BACKEND_CORS_ORIGINS=["https://your-site.vercel.app"]
# Also allow that project's preview deployments.
# BACKEND_CORS_ORIGIN_REGEX=https://.*\.vercel\.app
# Managed Postgres instead of SQLite. Install the extra first:
# pip install -e ".[postgres]"
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
# Where the committed model bundle lives, if it is moved.
# SERVING_ARTIFACTS_DIR=artifacts/serving
