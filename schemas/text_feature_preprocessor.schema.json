{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinematch.local/schemas/text_feature_preprocessor.schema.json",
  "title": "CineMatch Text Feature Preprocessor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at_utc",
    "data_version",
    "feature_contract_version",
    "fit_partition",
    "language",
    "seed",
    "positive_rating_threshold",
    "maximum_genres",
    "selection_order",
    "excluded_user_preference_genres",
    "fallback",
    "templates",
    "movie_text_format",
    "encoder",
    "text_feature_dimensions",
    "text_fusion",
    "rows",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "data_version": {"type": "string", "minLength": 1},
    "feature_contract_version": {"const": "hybrid-v1-167"},
    "fit_partition": {"const": "train"},
    "language": {"const": "en"},
    "seed": {"type": "integer"},
    "positive_rating_threshold": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "maximum_genres": {"type": "integer", "minimum": 1, "maximum": 19},
    "selection_order": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "string"}
    },
    "excluded_user_preference_genres": {
      "type": "array",
      "prefixItems": [{"const": "unknown"}],
      "minItems": 1,
      "maxItems": 1
    },
    "fallback": {"const": "highest_mean_observed_genres"},
    "templates": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "movie_text_format": {"const": "{title}. Genres: {genres}."},
    "encoder": {
      "type": "object",
      "required": [
        "schema_version",
        "encoder_type",
        "dimension",
        "lowercase",
        "ngram_range"
      ]
    },
    "text_feature_dimensions": {"const": 128},
    "text_fusion": {"const": "hadamard_product"},
    "rows": {
      "type": "object",
      "required": ["users", "movies", "fallback_users"],
      "properties": {
        "users": {"type": "integer", "minimum": 1},
        "movies": {"type": "integer", "minimum": 1},
        "fallback_users": {"type": "integer", "minimum": 0}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    }
  }
}
