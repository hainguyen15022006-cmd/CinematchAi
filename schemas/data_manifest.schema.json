{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinematch.local/schemas/data_manifest.schema.json",
  "title": "CineMatch Data Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at_utc",
    "dataset",
    "feature_contract",
    "entities",
    "split",
    "quality",
    "evaluation_contract",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "dataset": {
      "type": "object",
      "required": ["name", "version", "rating_scale"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "rating_scale": {
          "type": "array",
          "prefixItems": [
            {"type": "number"},
            {"type": "number"}
          ],
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "feature_contract": {
      "type": "object",
      "required": [
        "version",
        "ordered_layout",
        "total_dimensions",
        "genre_names"
      ],
      "properties": {
        "version": {"const": "hybrid-v1-167"},
        "ordered_layout": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4
        },
        "total_dimensions": {"const": 167},
        "genre_names": {
          "type": "array",
          "minItems": 19,
          "maxItems": 19,
          "items": {"type": "string"}
        }
      }
    },
    "entities": {"type": "object"},
    "split": {"type": "object"},
    "quality": {"type": "object"},
    "evaluation_contract": {"type": "object"},
    "artifacts": {"type": "object"}
  }
}
